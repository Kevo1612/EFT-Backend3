# Unidad systemd para EC2: levanta el stack al encender la instancia.
# Copiar a /etc/systemd/system/banco-xyz.service y ejecutar:
#   sudo systemctl daemon-reload && sudo systemctl enable --now banco-xyz
[Unit]
Description=Banco XYZ (docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/banco-xyz
EnvironmentFile=-/opt/banco-xyz/.env
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
